name: Diabetes_MLflow_Project

docker_env:
  image: dimasestascaptainkid/diabetes-mlflow:latest

entry_points:
  main:
    parameters:
      data_path: {type: str, default: "diabetes_preprocessing/diabetes_preprocessed.csv"}
      experiment_name: {type: str, default: "Workflow_CI_Advanced"}
    command: "python modelling.py --data_path {data_path}" 